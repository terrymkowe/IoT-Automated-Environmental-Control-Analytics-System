<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SmartTempMonApp.MainPage">

    <VerticalStackLayout Spacing="25" Padding="30">
        <Label Text="Smart Temperature Monitor" 
               FontSize="32" 
               HorizontalOptions="Center" />

        <!-- Display temperature -->
        <Label x:Name="temperatureLabel" 
               FontSize="28" 
               HorizontalOptions="Center" />

        <!-- Fan/Heater status -->
        <Label x:Name="fanHeaterStatusLabel" 
               FontSize="24" 
               HorizontalOptions="Center"
               TextColor="Gray"/>

        <!-- Refresh Button -->
        <Button Text="Refresh Temperature" 
                Clicked="OnRefreshTemperatureClicked" />

    </VerticalStackLayout>

</ContentPage>