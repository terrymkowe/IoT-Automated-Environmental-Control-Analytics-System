<?xml version="1.0" encoding="utf-8" ?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SmartTempMonApp.Pages.SignUpPage"
             Title="Sign Up"
             BackgroundColor="white">
    <ScrollView>
    <VerticalStackLayout Padding="30" Spacing="15" VerticalOptions="CenterAndExpand">

        <!-- Title -->
        <Label Text="Create Your Account" 
               FontSize="28" 
               FontAttributes="Bold"
               HorizontalOptions="Center"
               TextColor="Black"
               Margin="0,0,0,10"/>

        <!-- Username -->
        <Entry x:Name="usernameEntry" 
               Placeholder="Username" 
               Keyboard="Email"
               FontSize="18"
               BackgroundColor="Transparent"
               TextColor="Black"
               PlaceholderColor="Gray"
               HeightRequest="50"/>

        <!-- First Name -->
        <Entry x:Name="firstnameEntry" 
               Placeholder="First Name" 
               FontSize="18"
               BackgroundColor="Transparent"
               TextColor="Black"
               PlaceholderColor="Gray"
               HeightRequest="50"/>

        <!-- Surname -->
        <Entry x:Name="surnameEntry" 
               Placeholder="Surname" 
               FontSize="18"
               BackgroundColor="Transparent"
               TextColor="Black"
               PlaceholderColor="Gray"
               HeightRequest="50"/>

        <!-- Email -->
        <Entry x:Name="emailEntry" 
               Placeholder="Email Address" 
               Keyboard="Email"
               FontSize="18"
               BackgroundColor="Transparent"
               TextColor="Black"
               PlaceholderColor="Gray"
               HeightRequest="50"/>

        <!-- Password -->
        <Entry x:Name="passwordEntry" 
               Placeholder="Password" 
               IsPassword="True"
               FontSize="18"
               BackgroundColor="Transparent"
               TextColor="Black"
               PlaceholderColor="Gray"
               HeightRequest="50"/>

        <!-- Confirm Password -->
        <Entry x:Name="confirmPasswordEntry" 
               Placeholder="Confirm Password" 
               IsPassword="True"
               FontSize="18"
               BackgroundColor="Transparent"
               TextColor="Black"
               PlaceholderColor="Gray"
               HeightRequest="50"/>

        <!-- Error Message -->
        <Label x:Name="ErrorLabel"
               TextColor="Red"
               FontSize="14"
               IsVisible="False"
               HorizontalOptions="Center"
               Margin="0,5,0,0"/>

        <!-- Sign Up Button -->
        <Button Text="Sign Up"
                BackgroundColor="#4285F4"
                TextColor="White"
                FontSize="18"
                CornerRadius="10"
                HeightRequest="50"
                Clicked="OnSignUpClicked"
                Margin="0,10,0,0"/>

        <!-- Login Redirect -->
        <StackLayout Orientation="Horizontal" HorizontalOptions="Center">
            <Label Text="Already have an account?" FontSize="14" TextColor="#666"/>
            <Button Text="Log In"
                    BackgroundColor="Transparent"
                    TextColor="#4285F4"
                    FontSize="14"
                    Clicked="OnLoginClicked"/>
        </StackLayout>

    </VerticalStackLayout>
    </ScrollView>
</ContentPage>
