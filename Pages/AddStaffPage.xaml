<?xml version="1.0" encoding="utf-8" ?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SmartTempMonApp.Pages.AddStaffPage"
             Title="Add Staff Member"
             BackgroundColor="white">
    <ScrollView>
        <VerticalStackLayout Padding="30" Spacing="15" VerticalOptions="CenterAndExpand">

        <!-- Home Button -->
        <Button Text="Home"
                BackgroundColor="Transparent"
                TextColor="#4285F4"
                FontSize="16"
                Clicked="Home"
                HorizontalOptions="Start"/>

        <!-- Title -->
        <Label Text="Add New Staff Member" 
               FontSize="28" 
               FontAttributes="Bold"
               HorizontalOptions="Center"
               TextColor="Black"
               Margin="0,0,0,10"/>

        <!-- Username -->
        <Entry x:Name="UsernameEntry" 
               Placeholder="Username" 
               Keyboard="Email"
               FontSize="18"
               BackgroundColor="Transparent"
               TextColor="Black"
               PlaceholderColor="Gray"
               HeightRequest="50"/>

        <!-- First Name -->
        <Entry x:Name="firstnameEntry" 
               Placeholder="First Name" 
               FontSize="18"
               BackgroundColor="Transparent"
               TextColor="Black"
               PlaceholderColor="Gray"
               HeightRequest="50"/>

        <!-- Surname -->
        <Entry x:Name="surnameEntry" 
               Placeholder="Surname" 
               FontSize="18"
               BackgroundColor="Transparent"
               TextColor="Black"
               PlaceholderColor="Gray"
               HeightRequest="50"/>

        <!-- Email -->
        <Entry x:Name="emailEntry" 
               Placeholder="Email Address" 
               Keyboard="Email"
               FontSize="18"
               BackgroundColor="Transparent"
               TextColor="Black"
               PlaceholderColor="Gray"
               HeightRequest="50"/>

        <!-- Password -->
        <Entry x:Name="PasswordEntry" 
               Placeholder="Password" 
               IsPassword="True"
               FontSize="18"
               BackgroundColor="Transparent"
               TextColor="Black"
               PlaceholderColor="Gray"
               HeightRequest="50"/>

        <!-- Role Picker -->
        <Picker x:Name="RolePicker"
                Title="Click Below To Select Role"
                FontSize="18"
                TextColor="Black"
                BackgroundColor="black"
                HeightRequest="50"
                Margin="0,10,0,0"/>

        <!-- Error Message -->
        <Label x:Name="ErrorLabel"
               TextColor="Red"
               FontSize="14"
               IsVisible="False"
               HorizontalOptions="Center"
               Margin="0,5,0,0"/>

        <!-- Add Staff Button -->
        <Button Text="Add Staff"
                BackgroundColor="#4285F4"
                TextColor="White"
                FontSize="18"
                CornerRadius="10"
                HeightRequest="50"
                Clicked="AddStaffButton_Clicked"
                Margin="0,10,0,0"/>

    </VerticalStackLayout>
    </ScrollView>
</ContentPage>
