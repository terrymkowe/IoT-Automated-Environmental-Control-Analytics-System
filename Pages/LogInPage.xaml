<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SmartTempMonApp.Pages.LogInPage"
             Title="Sign in"
             BackgroundColor="white">
    <ScrollView>
    <VerticalStackLayout Padding="30" Spacing="20" VerticalOptions="CenterAndExpand">


        <Label Text="Welcome To Smart Temperature Monitoring App" 
               FontSize="28" 
               FontAttributes="Bold"
               HorizontalOptions="Center"
               TextColor="Black"/>
        <Image Source="tr.jpg" WidthRequest="100" HeightRequest="100" HorizontalOptions="Center"/>

        <Label Text="Sign in" 
               FontSize="28" 
               FontAttributes="Bold"
               HorizontalOptions="Center"
               TextColor="Black"/>

        <Label Text="Use your Smart Temperature Monitoring App Account"
               FontSize="14"
               TextColor="Gray"
               HorizontalOptions="Center"/>

        
        <Entry x:Name="usernameEntry" 
               Placeholder="Username" 
               Keyboard="Email"
               FontSize="18"
               BackgroundColor="Transparent"
               TextColor="Black"
               PlaceholderColor="Gray"
               HeightRequest="50"/>

        <Entry x:Name="passwordEntry" 
               Placeholder="Enter your password" 
               IsPassword="True"
               FontSize="18"
               BackgroundColor="Transparent"
               TextColor="Black"
               PlaceholderColor="Gray"
               HeightRequest="50"/>

        <Button Text="Login"
                BackgroundColor="#4285F4"
                TextColor="White"
                FontSize="18"
                CornerRadius="5"
                HeightRequest="50"
                Clicked="OnLoginClicked"/>

      

        <StackLayout Orientation="Horizontal" HorizontalOptions="Center">
            <Label Text="Don't have an account?" FontSize="14" TextColor="Gray"/>
            <Button Text="Create account"
                    BackgroundColor="Transparent"
                    TextColor="#4285F4"
                    FontSize="14"
                    Clicked="OnSignUpClicked"/>
        </StackLayout>

    </VerticalStackLayout>
    </ScrollView>
</ContentPage>