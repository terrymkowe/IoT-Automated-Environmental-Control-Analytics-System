<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:chart="clr-namespace:Syncfusion.Maui.Charts;assembly=Syncfusion.Maui.Charts"
             x:Class="SmartTempMonApp.Pages.TemperatureTrendsPage"
             Title="Temperature Trends"
             BackgroundColor="white">
    <ScrollView>
        <VerticalStackLayout Padding="30" Spacing="15" VerticalOptions="FillAndExpand">

        <!-- Home Button -->
        <Button Text="Home"
                BackgroundColor="Transparent"
                TextColor="#4285F4"
                FontSize="16"
                Clicked="Home"
                HorizontalOptions="Start"/>

        <!-- Page Title -->
        <Label Text="Temperature Trends"
               FontSize="28"
               FontAttributes="Bold"
               HorizontalOptions="Center"
               TextColor="Black"
               Margin="0,10,0,10"/>

        <!-- Temperature Chart -->
        <chart:SfCartesianChart HeightRequest="250">

            <!-- X-Axis (Time) -->
            <chart:SfCartesianChart.XAxes>
                <chart:CategoryAxis>
                    <chart:CategoryAxis.Title>
                        <chart:ChartAxisTitle Text="Time" FontSize="16"/>
                    </chart:CategoryAxis.Title>
                </chart:CategoryAxis>
            </chart:SfCartesianChart.XAxes>

            <!-- Y-Axis (Temperature) -->
            <chart:SfCartesianChart.YAxes>
                <chart:NumericalAxis>
                    <chart:NumericalAxis.Title>
                        <chart:ChartAxisTitle Text="Temperature (°C)" FontSize="16"/>
                    </chart:NumericalAxis.Title>
                </chart:NumericalAxis>
            </chart:SfCartesianChart.YAxes>

            <!-- Line Chart Series -->
            <chart:LineSeries ItemsSource="{Binding TemperatureData}"
                              XBindingPath="Timestamp"
                              YBindingPath="Temperature"
                              StrokeWidth="3"
                              />
        </chart:SfCartesianChart>

        <!-- Last 10 Temperature Trends Label -->
        <Label Text="Last 10 Temperature Readings"
               FontSize="20"
               FontAttributes="Bold"
               VerticalOptions="Center" 
               HorizontalOptions="Center"
               TextColor="Black"
               Margin="0,10,0,5"/>

        <!-- View Monthly Temperatures Button -->
        <Button Text="View Temperatures for the Last Month"
                BackgroundColor="#4285F4"
                TextColor="White"
                FontSize="18"
                CornerRadius="10"
                HeightRequest="50"
                Clicked="OnViewMonthlyTemperatureClicked"
                Margin="0,10,0,0"/>

    </VerticalStackLayout>
    </ScrollView>
</ContentPage>